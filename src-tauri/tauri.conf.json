{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pixel Stitch",
  "mainBinaryName": "pixel-stitch",
  "version": "../package.json",
  "identifier": "org.endlessaccess.pixelstitch",
  "build": {
    "frontendDist": "../.output-desktop/public",
    "beforeDevCommand": { "script": "npm run build:desktop", "wait": true },
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Pixel Stitch",
        "width": 1280,
        "height": 800,
        "center": true,
        "visible": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "publisher": "Endless Access",
    "copyright": "Endless Access",
    "category": "GraphicsAndDesign",
    "shortDescription": "Pixel art editor from Endless Studios",
    "longDescription": "Pixel Stitch is the Endless Studios pixel art editor: draw sprites and export them as PNG, GIF or sprite sheets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "startMenuFolder": "Pixel Stitch"
      }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0 (>= 2.40)"] },
      "rpm": { "depends": ["webkit2gtk4.1 >= 2.40"] }
    }
  }
}
